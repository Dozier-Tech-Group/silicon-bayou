# Copy to .env and fill in locally. Never commit .env.

# Hex private key of the deployer / collection owner (with or without 0x).
PRIVATE_KEY=

# Public RPCs are rate-limited. Prefer Alchemy for production:
#   https://robinhood-testnet.g.alchemy.com/v2/{API_KEY}
#   https://robinhood-mainnet.g.alchemy.com/v2/{API_KEY}
#
# Testnet (deploy here first):
RPC_URL=https://rpc.testnet.chain.robinhood.com
# Mainnet:
# RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Metadata base URI with trailing slash. tokenURI(1) => {BASE_URI}1.json
# After you upload metadata/*.json to IPFS:
BASE_URI=ipfs://REPLACE_ME/

# Optional mint recipient. Defaults to the deployer address.
# MINT_TO=
