# Copy to .env and fill in locally. Never commit .env.
# Do not paste PRIVATE_KEY into chat.

# Hex private key of the deployer / collection owner (with or without 0x).
PRIVATE_KEY=

# Official public RPCs (rate-limited). Docs: https://docs.robinhood.com/chain/connecting/
# Alchemy (recommended for production):
#   https://robinhood-mainnet.g.alchemy.com/v2/{API_KEY}
#   https://robinhood-testnet.g.alchemy.com/v2/{API_KEY}
#
# Mainnet (chain ID 4663, gas in ETH):
RPC_URL=https://rpc.mainnet.chain.robinhood.com
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Testnet (chain ID 46630):
# RH_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Metadata base URI with trailing slash. tokenURI(1) => {BASE_URI}1.json
# Launch host (no Pinata): GitHub raw metadata folder.
BASE_URI=https://raw.githubusercontent.com/Dozier-Tech-Group/silicon-bayou/master/metadata/swamp/

# Optional mint recipient. Defaults to the deployer address.
MINT_TO=0x29486Fc6B2E7184Dd4aF4d310D4f85F4262fD11d

# AccessDesk (commercial census / AI access). Canonical USDG on 4663 only.
# TREASURY=
# ACCESS_TAKE_BPS=3000
# USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# Required to pin or deploy-mint. Hybrid stills are frozen — set this locally:
GENESIS_ART_READY=1

# One of these unblocks scripts/pin.mjs (HD metadata/images/1-4 only):
# PINATA_JWT=
# NFT_STORAGE_KEY=
# WEB3_STORAGE_TOKEN=
# LIGHTHOUSE_API_KEY=
