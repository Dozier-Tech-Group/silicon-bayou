{
  "name": "silicon-bayou",
  "version": "0.1.0",
  "private": true,
  "description": "Silicon Bayou — Louisiana alligator capability NFTs on Robinhood Chain. NFT layer for Merged Public.",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test && vitest run",
    "test:contracts": "hardhat test",
    "test:app": "vitest run",
    "security": "solhint contracts/SiliconBayou.sol contracts/BountyBoard.sol contracts/MergedCredit.sol contracts/AccessDesk.sol && hardhat test",
    "freeze-uri": "hardhat run scripts/freeze-uri.js --network robinhood",
    "deploy:testnet": "hardhat run scripts/deploy.js --network robinhoodTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network robinhood",
    "deploy:bounty:testnet": "hardhat run scripts/deploy-bounty.js --network robinhoodTestnet",
    "deploy:bounty:mainnet": "hardhat run scripts/deploy-bounty.js --network robinhood",
    "deploy:access:testnet": "hardhat run scripts/deploy-bounty.js --network robinhoodTestnet",
    "deploy:access:mainnet": "hardhat run scripts/deploy-bounty.js --network robinhood",
    "deploy:mp:testnet": "hardhat run scripts/deploy-merged-public.js --network robinhoodTestnet",
    "deploy:mp:mainnet": "hardhat run scripts/deploy-merged-public.js --network robinhood",
    "mint:mp:testnet": "hardhat run scripts/mint-mp.js --network robinhoodTestnet",
    "mint:mp:mainnet": "hardhat run scripts/mint-mp.js --network robinhood",
    "copy-stills": "node scripts/copy-genesis-stills.mjs",
    "pin": "node scripts/pin.mjs",
    "wallet": "node scripts/check-wallet.mjs",
    "set-base-uri": "hardhat run scripts/set-base-uri.js --network robinhood",
    "mint:genesis": "hardhat run scripts/mint-genesis.js --network robinhood",
    "mint:testers": "hardhat run scripts/mint-to-tester.js --network robinhood",
    "gallery": "npx --yes serve . -p 4173",
    "agent:link": "node scripts/link-gator.mjs sign",
    "agent:verify": "node scripts/link-gator.mjs verify",
    "agent:run": "node agents/run-agent.mjs",
    "agent:land": "node agents/land-prs.mjs",
    "settle": "hardhat run scripts/settle-bounty.js --network robinhood",
    "fund-bounties": "hardhat run scripts/fund-bounties.js --network robinhood"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.2.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "chai": "^4.5.0",
    "dotenv": "^16.6.1",
    "ethers": "^6.15.0",
    "happy-dom": "^20.11.2",
    "hardhat": "^2.26.3",
    "ipfs-only-hash": "^4.0.0",
    "solhint": "^5.2.0",
    "vitest": "^3.2.4"
  }
}
